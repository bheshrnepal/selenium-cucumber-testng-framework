<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Default suite: runs every Cucumber feature through TestNG.
  data-provider-thread-count = how many scenarios run at the same time (1 = one after another).
-->
<suite name="SauceDemo Cucumber Suite" data-provider-thread-count="1">
    <test name="Cucumber BDD Tests">
        <classes>
            <class name="com.saucedemo.runners.TestRunner"/>
        </classes>
    </test>
</suite>
